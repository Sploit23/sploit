{
  "name": "@opencode-ai/forge-tray",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "dev": "bun run build:main && electron .",
    "build:main": "bun build src/main.ts src/pairing.ts --outdir=src --target=node --format=esm --external electron",
    "package:win": "bun run build:main && electron-builder --win --config electron-builder.config.js"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/node": "catalog:",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "typescript": "catalog:"
  }
}
