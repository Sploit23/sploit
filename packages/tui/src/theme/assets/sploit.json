    "darkMagenta": "#ff40dc",
    "darkViolet": "#b388ff",
    "darkRed": "#ff4d6d",
    "darkAmber": "#ffb86c",
    "darkGreen": "#39ff88",
    "darkInfo": "#5ad1ff",
    "darkSelectedText": "#03060a",
    "lightBg0": "#f4fbff",
