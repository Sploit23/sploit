{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["SPLOIT_STATE.md", "APRENDIZADO.md"],
  "small_model": "google/gemini-3.5-flash-lite",
  "model_fallback": ["google/gemini-3.6-flash"],
  "permission": {
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "task": "allow",
    "bash": { "*": "allow" },
    "external_directory": { "*": "allow" }
  },
  "agent": {
    "plan": { "model": "google/gemini-3.6-flash" },
    "build": { "model": "google/gemini-3.6-flash" }
  },
  "plugin": [
    "github:obra/superpowers"
  ],
  "skills": {
    "paths": [
      "~/.config/sploit/node_modules/superpowers/skills"
    ]
  },
  "mcp": {
    "graphify": {
      "type": "local",
      "command": [
        "venv\\Scripts\\graphify-mcp.exe",
        "--graph",
        "graphify-out/graph.json"
      ],
      "timeout": 30000
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "timeout": 30000
    }
  }
}
