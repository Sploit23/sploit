{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["SPLOIT_STATE.md", "APRENDIZADO.md"],
  "small_model": "github-copilot/gpt-4o-mini",
  "permission": {
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "task": "allow",
    "bash": { "*": "allow" },
    "external_directory": { "*": "allow" }
  },
  "agent": {
    "plan": { "model": "github-copilot/gpt-4.1" },
    "build": { "model": "github-copilot/gpt-4.1" }
  },
  "plugin": [
    "C:\\Users\\Hp\\.config\\sploit\\node_modules\\superpowers"
  ],
  "skills": {
    "paths": [
      "~/.config/sploit/node_modules/superpowers/skills"
    ]
  },
  "mcp": {
    "graphify": {
      "type": "local",
      "command": [
        "C:\\Users\\Hp\\Desktop\\sploit\\venv\\Scripts\\graphify-mcp.exe",
        "--graph",
        "graphify-out/graph.json"
      ],
      "timeout": 30000
    },
    "context7": {
      "type": "local",
      "command": [
        "C:\\Program Files\\nodejs\\npx.cmd",
        "-y",
        "@upstash/context7-mcp"
      ],
      "timeout": 30000
    }
  }
}
